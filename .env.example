# Copia este archivo como .env y completa el token. .env no se sube a git.

# Token del bot de Telegram (créalo con @BotFather). Sólo lo usa el servidor:
# la app nunca lo ve.
TELEGRAM_BOT_TOKEN=

# Horas que se guarda un pack ya convertido antes de volver a convertirlo.
PACK_TTL_HOURS=24

# Procesos de conversión en paralelo. Vacío = uno por núcleo.
# CONVERT_WORKERS=2
